# Google Gemini API Configuration for AI Disk Analyzer
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Request timeout in seconds (default: 60)
GEMINI_TIMEOUT_SECONDS=60

# Max retries for transient failures (default: 2)
GEMINI_MAX_RETRIES=2

